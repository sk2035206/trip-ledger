# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/.vinext/
/out/

# misc
.DS_Store
*.pem
mysql.json
/tsconfig.tsbuildinfo

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
/logs/*.log
/logs/*.pid

# env files (can opt-in for committing if needed)
.env*

# local database credentials
/config/mysql.json
/config/deploy.env

# vercel
.vercel
.idea

/dist/
/release/
/.wrangler/
/outputs/
/work/

# WeChat mini program
/miniprogram/node_modules/
/miniprogram/dist/
/miniprogram/.taro/
/miniprogram/project.private.config.json
/miniprogram/.swc/

# Per-developer WeChat IDE preferences (both import roots)
/project.private.config.json

# WeChat CI upload private key
/config/private.key

# Isolated WeChat CI tool dependencies
/tools/wechat-ci/node_modules/
