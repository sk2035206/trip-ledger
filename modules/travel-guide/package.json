{
  "name": "travel-guide",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node server.mjs",
    "start": "node server.mjs --production",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.mjs",
    "dev:lan": "node server.mjs --lan",
    "start:lan": "node server.mjs --production --lan"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "dependencies": {
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "tsx": "4.22.1",
    "typescript": "5.9.3",
    "vite": "8.3.5"
  }
}
